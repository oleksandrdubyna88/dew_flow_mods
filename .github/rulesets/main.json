{
  "$note": "main is written by pull request only: no deletion, no force push, linear history, squash merges, resolved threads, and the five checks that report on a pull request, each as posted by the Actions app (integration_id 15368, read from PR #1's check runs, never typed): a status posted by another identity does not count. No bypass actor: an administrator is not exempt.",
  "name": "main",
  "target": "branch",
  "enforcement": "active",
  "conditions": { "ref_name": { "include": ["refs/heads/main"], "exclude": [] } },
  "bypass_actors": [],
  "rules": [
    { "type": "deletion" },
    { "type": "non_fast_forward" },
    { "type": "required_linear_history" },
    {
      "type": "pull_request",
      "parameters": {
        "allowed_merge_methods": ["squash"],
        "dismiss_stale_reviews_on_push": false,
        "require_code_owner_review": false,
        "require_last_push_approval": false,
        "required_approving_review_count": 0,
        "required_review_thread_resolution": true,
        "required_reviewers": [],
        "require_extra_approval_for_unattributed_changes": true
      }
    },
    {
      "type": "required_status_checks",
      "parameters": {
        "strict_required_status_checks_policy": true,
        "do_not_enforce_on_create": false,
        "required_status_checks": [
          { "context": "mods · tools", "integration_id": 15368 },
          { "context": "mods · plugin", "integration_id": 15368 },
          { "context": "family · plans · pins · adapter", "integration_id": 15368 },
          { "context": "workflows · actionlint", "integration_id": 15368 },
          { "context": "pr · semantic title", "integration_id": 15368 }
        ]
      }
    }
  ]
}
